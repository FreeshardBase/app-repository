networks:
    portal:
        external: true

services:
    pinchflat-ngx:
        restart: always
        image: ghcr.io/thebadfella/pinchflat-ngx:2026.10.16
        container_name: pinchflat-ngx
        volumes:
        - "{{ fs.app_data }}/config:/config"
        - "{{ fs.shared }}/media:/downloads"
        networks:
        - portal
