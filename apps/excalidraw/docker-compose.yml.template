networks:
    portal:
        external: true
    excalidraw:

services:
    excalidraw:
        restart: always
        image: nginx:1.27-alpine
        container_name: excalidraw
        command:
        - sh
        - -c
        - |
            cat > /etc/nginx/conf.d/default.conf <<'NGINX'
            map $$http_upgrade $$connection_upgrade {
                default upgrade;
                ''      close;
            }

            server {
                listen 80;
                server_name _;
                client_max_body_size 100m;

                location /socket.io/ {
                    proxy_pass http://excalidraw-room:80;
                    proxy_http_version 1.1;
                    proxy_set_header Upgrade $$http_upgrade;
                    proxy_set_header Connection $$connection_upgrade;
                    proxy_set_header Host $$host;
                    proxy_read_timeout 86400;
                }

                location /api/ {
                    proxy_pass http://excalidraw-storage:8080;
                    proxy_set_header Host $$host;
                    proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
                    proxy_set_header X-Forwarded-Proto $$scheme;
                }

                location / {
                    proxy_pass http://excalidraw-frontend:80;
                    proxy_set_header Host $$host;
                    proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
                    proxy_set_header X-Forwarded-Proto $$scheme;
                }
            }
            NGINX
            exec nginx -g 'daemon off;'
        depends_on:
        - excalidraw-frontend
        - excalidraw-room
        - excalidraw-storage
        networks:
        - portal
        - excalidraw

    excalidraw-frontend:
        restart: always
        # upstream publishes a mutable :latest; pin by digest (tag v0.18.1-fork-b2, Excalidraw 0.18.1)
        image: alswl/excalidraw@sha256:f605184e5c9a0c2b1247ffa23dacf50e7b2f86004d25dfc7f64eaf1a7018e2cd
        container_name: excalidraw-frontend
        environment:
        - VITE_APP_WS_SERVER_URL=https://excalidraw.{{ portal.domain }}
        - PUBLIC_URL=https://excalidraw.{{ portal.domain }}
        - VITE_APP_STORAGE_BACKEND=http
        - VITE_APP_HTTP_STORAGE_BACKEND_URL=/api/v2
        - VITE_APP_BACKEND_V2_GET_URL=/api/v2/scenes/
        - VITE_APP_BACKEND_V2_POST_URL=/api/v2/scenes/
        - VITE_APP_FIREBASE_CONFIG={}
        - VITE_APP_DISABLE_TRACKING=true
        networks:
        - excalidraw

    excalidraw-room:
        restart: always
        # upstream publishes only mutable :latest / sha- tags; pin by digest (tag sha-03ff435)
        image: excalidraw/excalidraw-room@sha256:2fe999f9be4379e3ee282fc45d75d84a691a6383dde33544514cc395287c7a70
        container_name: excalidraw-room
        networks:
        - excalidraw

    excalidraw-storage:
        restart: always
        # maintained MIT fork; only tag is v2023.11.11, pinned by digest. Keyv over redis
        # (bundled @keyv/redis, pure-JS client; the image's sqlite3 native binding does not load on its musl base)
        image: alswl/excalidraw-storage-backend@sha256:ca35be07c0513e1f36be44fc40bffee4062ab8341e29f4133eafc48718acd88e
        container_name: excalidraw-storage
        environment:
        - STORAGE_URI=redis://excalidraw-redis:6379
        depends_on:
        - excalidraw-redis
        networks:
        - excalidraw

    excalidraw-redis:
        restart: always
        image: redis:7-alpine
        container_name: excalidraw-redis
        command: redis-server --appendonly yes
        volumes:
        - "{{ fs.app_data }}/redis:/data"
        networks:
        - excalidraw
