version: '3.5'
networks:
  portal:
    external: true
  umami:

services:
  umami:
    image: ghcr.io/umami-software/umami:3.4.1
    container_name: umami
    restart: always
    depends_on:
      - umami-postgres
    environment:
      - DATABASE_URL=postgresql://umami:umami@umami-postgres:5432/umami
      - DATABASE_TYPE=postgresql
      - APP_SECRET={{ portal.id }}
      - DISABLE_TELEMETRY=1
      - MCP_ENABLED=1
      - BASE_URL=https://umami.{{ portal.domain }}
    networks:
      - portal
      - umami

  umami-postgres:
    image: postgres:15-alpine
    container_name: umami-postgres
    restart: always
    volumes:
      - "{{ fs.app_data }}/postgres:/var/lib/postgresql/data"
    environment:
      - POSTGRES_DB=umami
      - POSTGRES_USER=umami
      - POSTGRES_PASSWORD=umami
    networks:
      - umami
